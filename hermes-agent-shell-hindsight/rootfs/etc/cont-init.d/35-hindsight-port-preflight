#!/command/with-contenv bash
# Port pre-flight (agent-images#170): refuse to boot when 127.0.0.1:5433 is
# already held in the shared pod netns.
#
# On frank a stray postgres in the ssh-sidecar held 5433, so ours could never
# bind; the pod stayed Running with a dead database. Failing here is the
# earliest, cheapest signal.
#
# This relies on S6_BEHAVIOUR_IF_STAGE2_FAILS=2: a failing cont-init stops the
# whole container before any longrun starts, so there is nothing to halt and we
# deliberately do NOT call halt-container (the exit code is s6's own).
#
# HINDSIGHT_PG_PORT is a test seam; the real port is always 5433.
port=${HINDSIGHT_PG_PORT:-5433}

# Probe outcomes: 0 = something accepted (held); 1 = refused (free);
# 124 = no answer within 2s; 126/127 = the probe itself could not run. Loopback
# refuses a free port at once, so anything but 0 or 1 is not "free": fail
# closed and say which, rather than guess.
timeout 2 bash -c "exec 3<>/dev/tcp/127.0.0.1/$port" 2>/dev/null
rc=$?
if [ "$rc" -ne 0 ] && [ "$rc" -ne 1 ]; then
  echo "[hindsight-preflight] FATAL: cannot tell whether 127.0.0.1:$port is free" \
       "(probe rc=$rc: 124 = no answer within 2s, 126/127 = timeout/bash unavailable);" \
       "refusing to start postgres blind" >&2
  exit 1
fi
if [ "$rc" -eq 0 ]; then
  cat >&2 <<MSG
[hindsight-preflight] FATAL: 127.0.0.1:$port is already in use.
Our postgres would collide with it in the shared pod netns and could never
start. Known cause: frank's stray postgres in the ssh-sidecar container.
Free the port (stop whatever listens there) and restart the pod.
MSG
  exit 1
fi

echo "[hindsight-preflight] 127.0.0.1:$port free"
exit 0
