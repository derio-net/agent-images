#!/command/with-contenv bash
# hindsight-api (hindsight-api-slim 0.8.5) — the local_external backend Hermes
# talks to over the pod loopback at 127.0.0.1:8888.
#
# Launch command + stable settings are the ground-truth recipe from the live
# migrate pod (willikins#285). The HINDSIGHT_API_* settings are pydantic-
# settings env (no config file). The DATABASE_URL / EMBEDDINGS / RERANKER
# values are fixed for this image and baked as ENV in the Dockerfile; the
# LLM_* retain vars come from the frank manifest (claude-code provider, or
# `none` for recall-only) and are inherited here via with-contenv.
#
# Direct exec, no s6-setuidgid — same reason as the postgres run script.
#
# hindsight-api needs Postgres accepting connections before it binds, so we
# gate on pg_isready, then verify the postgres answering is OURS (system
# identifier match, agent-images#170) - pg_isready alone is satisfied by a
# foreign postgres squatting on 5433 in the shared pod netns. s6 supervises
# restarts; no while/sleep restart loop.
export MAMBA_ROOT_PREFIX=/opt/micromamba
export HF_HOME=${HF_HOME:-/opt/hindsight-models}
: "${HINDSIGHT_API_LLM_PROVIDER:=none}"
export HINDSIGHT_API_LLM_PROVIDER

PGBIN=${HINDSIGHT_PG_BIN:-/opt/micromamba/envs/hindsight-pg/bin}
PGDATA=${HINDSIGHT_PGDATA:-/opt/hindsight/pgdata}
HALT=${HINDSIGHT_HALT:-/usr/local/lib/hindsight/halt-container}

# Wait for the loopback Postgres to accept connections.
until "$PGBIN/pg_isready" -h 127.0.0.1 -p 5433 -q; do
  echo "[hindsight-api] waiting for postgres on 127.0.0.1:5433 ..."
  sleep 1
done

# Identity, not just liveness: pg_isready is satisfied by ANY postgres on
# 5433, including a foreign one in the shared pod netns (frank's ssh-sidecar
# stray, agent-images#170). Compare the system identifier of our PGDATA with
# the one the server on 5433 reports; a mismatch (or anything unreadable)
# halts the container rather than letting hindsight-api talk to a stranger.
# Keep each tool's stderr so the halt reason says WHY (auth, refused, no PGDATA).
errf=$(mktemp "${TMPDIR:-/tmp}/hindsight-identity.XXXXXX" 2>/dev/null) || errf=/dev/null
ctl_out=$(LC_ALL=C "$PGBIN/pg_controldata" -D "$PGDATA" 2>"$errf")
expected_rc=$?
ctl_err=$(head -c 300 "$errf")
expected=$(printf '%s\n' "$ctl_out" | sed -n 's/^Database system identifier:[[:space:]]*//p')
served=$(PGCONNECT_TIMEOUT=5 "$PGBIN/psql" -X -w -h 127.0.0.1 -p 5433 -U hindsight -d postgres \
  -Atc 'select system_identifier from pg_control_system()' 2>"$errf")
served_rc=$?
psql_err=$(head -c 300 "$errf")
[ "$errf" = /dev/null ] || rm -f "$errf"

if [ "$expected_rc" -ne 0 ] || [ "$served_rc" -ne 0 ] || [ -z "$expected" ] || [ -z "$served" ]; then
  "$HALT" 1 "cannot verify the postgres on 127.0.0.1:5433 is ours (pg_controldata rc=${expected_rc} id='${expected}', psql rc=${served_rc} id='${served}'; pg_controldata stderr: ${ctl_err:-none}; psql stderr: ${psql_err:-none}); refusing to start hindsight-api"
  exit 1
fi
if [ "$expected" != "$served" ]; then
  "$HALT" 1 "the postgres on 127.0.0.1:5433 is not ours: serves system identifier ${served}, our PGDATA is ${expected} (a foreign postgres holds the port in the pod netns)"
  exit 1
fi

exec micromamba run -n hindsight-pg \
  hindsight-api --host 127.0.0.1 --port 8888 --log-level info
